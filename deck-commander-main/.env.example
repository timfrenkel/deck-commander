# Clash Royale API Key (https://developer.clashroyale.com)
# Achtung: Bei Supercell die IP whitelisten, von der dein Server requests sendet.
CLASH_API_KEY=your_supercell_api_key_here

# Backend (Express) Bind
HOST=0.0.0.0
PORT=3000

# Frontend -> Backend URL (zur Build-Zeit ins Vite Bundle inlined)
# Lokal:        http://localhost:3000
# VPS Beispiel: http://5.75.140.186:3000
# Mit Domain:   https://api.deine-domain.de
VITE_API_BASE_URL=http://localhost:3000